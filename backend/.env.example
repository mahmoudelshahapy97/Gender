# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Gender Analytics API"
APP_DESCRIPTION="Gender-aware people counting: unique visits and occupancy by male, female and child"
APP_VERSION="1.0.0"
APP_API_PREFIX="/api/v1"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_DEBUG=true
ENVIRONMENT=development

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# =============================================================================
# CORS
# =============================================================================
# The console reaches the API through a same-origin proxy (Vite in dev, nginx
# in the container), so CORS is not normally involved. These cover the case of
# a browser pointed straight at the API host.
CORS_ORIGINS='["http://localhost:5173","http://localhost:8083","http://localhost:8004"]'
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS='["GET","POST","PUT","PATCH","DELETE"]'
CORS_ALLOW_HEADERS='["Content-Type","Authorization","X-Request-ID","X-Workspace-Id"]'

# =============================================================================
# AUTH
# =============================================================================
# Required -- the app refuses to start without it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="generate-your-own-see-comment-above"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set true once served over HTTPS.
AUTH_COOKIE_NAME=gd_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# There is no public signup. This account is created once, when app_user is
# empty at startup. Change the password after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@insighteye.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123

# "Forgot your password?" mails a 6-digit code to the account's email. It is
# off (the link is hidden) until SMTP_HOST is set below.
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# =============================================================================
# EMAIL (SMTP) -- only used for password-reset codes
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Gender Analytics <no-reply@insighteye.local>"
# STARTTLS on 587; set SMTP_SSL=true (and SMTP_STARTTLS=false) for port 465.
SMTP_STARTTLS=true
SMTP_SSL=false

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE_PATH="logs/gender.log"

# =============================================================================
# DATABASE (POSTGRES)
# =============================================================================
POSTGRES_DB="gender_db"
POSTGRES_USER="gender"
POSTGRES_PASSWORD="gender_pass"
DB_HOST="db"
DB_PORT=5432

DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10
DB_TIMEOUT=30.0
DB_COMMAND_TIMEOUT=60.0
DB_MAX_RETRIES=10
DB_RETRY_DELAY_BASE=2
DB_RETRY_DELAY_MAX=30

# =============================================================================
# MODELS
# =============================================================================
YOLO_CONFIG_DIR="/app/.ultralytics"
MODEL_DEVICE=cuda

# InsightEye's production weights (YOLO26-N detectors, 640 px). See models/README.md.
PEOPLE_MODEL_PATH="models/people.pt"
PEOPLE_CONFIDENCE=0.5
PEOPLE_CLASS_ID=0
GENDER_MODEL_PATH="models/gender.pt"
# InsightEye production runs 0.4
GENDER_CONFIDENCE=0.4
# gender.pt class id -> label stored; ids left out are ignored
GENDER_CLASS_MAP='{"0":"female","1":"male","2":"child"}'
YOLO_INPUT_SIZE=640
YOLO_HALF=true
# ByteTrack tuned for people at ~5 processed fps
YOLO_TRACKER="trackers/gender_bytetrack.yaml"

# =============================================================================
# GENDER COUNTING
# =============================================================================
# gender.pt runs on every Nth processed frame (InsightEye: every 3rd)
GENDER_EVERY_N=3
# A gender box belongs to a person when it covers this share of the smaller box
GENDER_MATCH_OVERLAP=0.6
# Votes needed before a person's label is trusted (until then: unknown)
GENDER_MIN_VOTES=2
# A person unseen this long has left; their visit is written
VISIT_GAP_SECONDS=6.0
# Shorter visits are dropped (detector flicker)
VISIT_MIN_DWELL_S=1.5
# One occupancy row + annotated frame per camera this often
SNAPSHOT_INTERVAL_S=60
SNAPSHOT_STORE_FRAMES=true


# =============================================================================
# RTSP / STREAM
# =============================================================================
RTSP_TRANSPORT=tcp
RTSP_BUFFER_SIZE=1
RTSP_OPEN_TIMEOUT=15.0
RTSP_READ_FAILURE_LIMIT=30
RTSP_RECONNECT_DELAY_BASE=2.0
RTSP_RECONNECT_DELAY_MAX=30.0

# Process 1 out of every N decoded frames
FRAME_SKIP=5
TARGET_PROCESS_FPS=5.0
JPEG_QUALITY=85

STREAM_START_STAGGER_DELAY=2.0
STREAM_WORKER_RESTART_DELAY=5.0

# Concurrent MJPEG live viewers across all cameras
MAX_MJPEG_CLIENTS=4

# =============================================================================
# WORKER SUPERVISION
# =============================================================================
# Restart dead, errored or stalled workers; start enabled cameras with no worker
WORKER_SUPERVISION_ENABLED=true
WORKER_SUPERVISION_INTERVAL_S=15.0
WORKER_RESTART_BACKOFF_BASE_S=5.0
WORKER_RESTART_BACKOFF_MAX_S=300.0

# =============================================================================
# RETENTION
# =============================================================================
RETENTION_ENABLED=true
RETENTION_INTERVAL_S=21600
# Snapshot frames older than this are deleted (the counts stay)
FRAME_RETENTION_DAYS=30
# Snapshot and visit rows older than this are deleted (0 = keep forever)
DATA_RETENTION_DAYS=365

# =============================================================================
# OBJECT STORAGE (MinIO)
# =============================================================================
# Snapshot frames go to MinIO; Postgres keeps the records and object keys.
# docker-compose sets these for the api from the root .env. Leave the endpoint
# empty to keep frames in Postgres.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=gender
MINIO_SECURE=false
